{
  "name": "Nekudot — Hebrew Nikud (vowel marks) on any page",
  "version": "2.0.1",
  "description": "One-click nikud (niqqud / Hebrew vowel marks) on any page. Runs on-device — private, offline, no account. ניקוד לכל טקסט",
  "homepage_url": "https://github.com/GiladAmar/Nekudot",
  "manifest_version": 3,
  "background": {
    "service_worker": "background.js"
  },
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'"
  },
  "permissions": [
    "activeTab",
    "contextMenus",
    "scripting"
  ],
  "commands": {
    "add-nekudot": {
      "suggested_key": {
        "default": "Alt+Shift+N"
      },
      "description": "Add nekudot to the selection (or the whole page)"
    }
  },
  "action": {
    "default_icon": {
      "16": "/images/aleph_16.png",
      "32": "/images/aleph_32.png",
      "48": "/images/aleph_48.png",
      "128": "/images/aleph_128.png"
    }
  },
  "icons": {
    "16": "/images/aleph_16.png",
    "32": "/images/aleph_32.png",
    "48": "/images/aleph_48.png",
    "128": "/images/aleph_128.png"
  }
}
